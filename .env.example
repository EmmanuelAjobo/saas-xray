# Copy to .env for local development:  cp .env.example .env
# Every variable here is validated at boot (src/core/config/env.schema.ts).
# The app refuses to start if a required one is missing or malformed.

NODE_ENV=development
PORT=3000

# Origin of the web app. Used as the CORS allowlist (no wildcards, ever).
WEB_ORIGIN=http://localhost:3001

# Number of reverse proxies in front of the API (0 = none, 1 = Railway/Render/Fly).
# Needed so rate limiting sees the real client IP instead of the load balancer's.
TRUST_PROXY_HOPS=0

# Requests slower than this fail cleanly with 408.
REQUEST_TIMEOUT_MS=10000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Base URL used in the "type" field of error responses (RFC 7807).
ERROR_DOCS_BASE_URL=http://localhost:3000/docs/errors

# Port 5433 (see docker-compose.yml): avoids clashing with a Postgres installed on the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/saas_xray
REDIS_URL=redis://localhost:6379

# Signs access tokens. Generate your own:  openssl rand -base64 48
# The app refuses to start in production while this still starts with "change-me".
JWT_ACCESS_SECRET=change-me-dev-only-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_MAX_AGE_DAYS=30

# Email. Locally everything goes to Mailpit (inbox at http://localhost:8025).
# In production set MAIL_DRIVER=resend and RESEND_API_KEY.
MAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="SaaS X-ray <no-reply@saas-xray.local>"
# RESEND_API_KEY=

# ───────── Tunables (all optional: these are the defaults) ─────────
# Email
MAIL_TIMEOUT_MS=10000
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Password hashing cost (argon2id, OWASP baseline). Raise over time; old hashes keep working.
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_PASSES=2
PASSWORD_HASH_PARALLELISM=1

# Rate limits (the app-wide default is per client IP; "credentials" is per IP + email)
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_CREDENTIALS_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_TOKEN_ACTIONS_PER_MINUTE=10
RATE_LIMIT_RESEND_PER_HOUR=5

# Infrastructure timeouts and retries
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10
REDIS_MAX_RETRIES_PER_REQUEST=2
HEALTH_CHECK_TIMEOUT_MS=2000
CORS_MAX_AGE_SECONDS=600

# Organisations
MAX_ORGS_PER_USER=5
RATE_LIMIT_ORG_CREATE_PER_HOUR=10

# Invitations and plan limits
INVITATION_TTL_DAYS=7
RATE_LIMIT_INVITE_PER_HOUR=30
FREE_PLAN_MAX_SEATS=3
PRO_PLAN_MAX_SEATS=25

# Lists and invoices
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
INVOICE_DEFAULT_CURRENCY=USD
INVOICE_DEFAULT_TERMS_DAYS=14
INVOICE_MAX_LINE_ITEMS=100

# The "Try the demo" button
DEMO_ENABLED=true
DEMO_MAX_ACTIVE=200
RATE_LIMIT_DEMO_PER_HOUR=10
DEMO_PURGE_INTERVAL_MINUTES=15
DEMO_PURGE_BATCH_SIZE=50
CAPTCHA_TIMEOUT_MS=5000
# Cloudflare Turnstile secret: when set, the demo button needs a valid challenge token.
# TURNSTILE_SECRET_KEY=

# Demo sandbox lifetime
DEMO_TTL_HOURS=24

# Demo sandboxes never send real email: what they would have sent is kept in an in-app Outbox
# (newest first, at most this many per sandbox, gone when the sandbox expires).
OUTBOX_MAX_MESSAGES=20

# Backend X-ray: a live record of what the backend does for each request (events never
# contain request bodies, tokens or personal data). XRAY_ENABLED=false switches it off.
XRAY_ENABLED=true
XRAY_BUFFER_SIZE=200
XRAY_BUFFER_TTL_SECONDS=3600
XRAY_REPLAY_DEFAULT=50
XRAY_HEARTBEAT_SECONDS=15
XRAY_STREAM_MAX_SECONDS=600
XRAY_MAX_STREAMS_PER_USER=3

# ───────── docker-compose only (read by `docker compose`, not by the app) ─────────
# If you change the Postgres values, change DATABASE_URL above to match. They only apply
# to a NEW empty database; an existing volume keeps its original user and password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_xray
POSTGRES_PORT=5433
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
